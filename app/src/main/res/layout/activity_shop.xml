<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F6F7">

    <!-- Scrollable Content Area -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- SEARCH BAR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_margin="16dp"
                android:background="@drawable/bg_search_bar"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_search"
                    app:tint="#9E9E9E" />

                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:background="@android:color/transparent"
                    android:hint="Search products..."
                    android:inputType="text"
                    android:textColorHint="#9E9E9E"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- FILTER CHIPS -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Selected Chip -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_chip_selected"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="10dp"
                        android:text="All gifts"
                        android:textColor="@android:color/white"
                        android:textSize="14sp" />

                    <!-- Unselected Chips -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="10dp"
                        android:text="Birthday"
                        android:textColor="#424242"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="10dp"
                        android:text="Anniversary"
                        android:textColor="#424242"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="10dp"
                        android:text="New Baby"
                        android:textColor="#424242"
                        android:textSize="14sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- SORT & FILTER ROW -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="12 gifts"
                    android:textColor="#757575"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="Sort &amp; filter"
                    android:textColor="#212121"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- PRODUCT GRID (Using GridLayout for easy scrollview wrapping) -->
            <GridLayout
                android:id="@+id/productGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_marginTop="8dp"
                android:columnCount="2"
                android:useDefaultMargins="false">
                <!-- Items will be inflated here by Kotlin -->
            </GridLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- BOTTOM NAVIGATION BAR -->
    <View
        android:id="@+id/navDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation" />

    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@android:color/white"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Home -->
        <LinearLayout android:id="@+id/navHome" style="@style/BottomNavItem">
            <ImageView style="@style/BottomNavIcon" android:src="@android:drawable/ic_menu_view" app:tint="#757575" />
            <TextView style="@style/BottomNavText" android:text="Home" />
        </LinearLayout>

        <!-- Shop (Selected) -->
        <LinearLayout android:id="@+id/navShop" style="@style/BottomNavItem">
            <ImageView style="@style/BottomNavIcon" android:src="@android:drawable/ic_menu_agenda" app:tint="#D3154A" />
            <TextView style="@style/BottomNavText" android:text="Shop" android:textColor="#D3154A" />
        </LinearLayout>

        <!-- Wishlist with Badge -->
        <LinearLayout android:id="@+id/navWishlist" style="@style/BottomNavItem">
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView style="@style/BottomNavIcon" android:src="@android:drawable/ic_menu_myplaces" app:tint="#757575" />
                <TextView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="-4dp"
                    android:layout_marginEnd="-4dp"
                    android:background="@drawable/bg_bottom_nav_badge"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="@android:color/white"
                    android:textSize="10sp" />
            </FrameLayout>
            <TextView style="@style/BottomNavText" android:text="Wishlist" />
        </LinearLayout>

        <!-- Cart -->
        <LinearLayout android:id="@+id/navCart" style="@style/BottomNavItem">
            <ImageView style="@style/BottomNavIcon"
                android:src="@drawable/ic_gift" app:tint="#757575" />
            <TextView style="@style/BottomNavText" android:text="Cart" />
        </LinearLayout>

        <!-- Profile -->
        <LinearLayout android:id="@+id/navProfile" style="@style/BottomNavItem">
            <ImageView style="@style/BottomNavIcon" android:src="@android:drawable/ic_menu_myplaces" app:tint="#757575" />
            <TextView style="@style/BottomNavText" android:text="Profile" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>